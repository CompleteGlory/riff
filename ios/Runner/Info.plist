<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App uses only standard/exempt encryption (HTTPS/TLS). Declaring this skips
	     the Export Compliance question on every TestFlight/App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSContactsUsageDescription</key>
	<string>Riff uses your contacts to find friends who are already on the app.</string>

	<!-- URL schemes registered so Riff can open TikTok, Instagram, and Spotify -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tiktok</string>
		<string>snssdk1233</string>
		<string>instagram</string>
		<string>spotify</string>
	</array>

	<!-- Custom URL scheme so Spotify / other OAuth providers can redirect back to Riff -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.riff.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.riff.app</string>
			</array>
		</dict>
		<!-- Google Sign-In OAuth callback (REVERSED_CLIENT_ID from GoogleService-Info.plist) -->
		<dict>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.369305642937-midvt5mj7r6pl9jeodkl6eqji72qs0hf</string>
			</array>
		</dict>
	</array>

	<!-- Google Sign-In client id (CLIENT_ID from GoogleService-Info.plist) -->
	<key>GIDClientID</key>
	<string>369305642937-midvt5mj7r6pl9jeodkl6eqji72qs0hf.apps.googleusercontent.com</string>

	<!--
	  NSExtension removed: this key is only valid inside an app-extension bundle's
	  Info.plist, not the main app's. It never functioned as a share extension
	  (there is no Share Extension target) and caused App Store validation error
	  90190 ("Invalid Info.plist Key. The key 'NSExtension' ... is not valid").
	  Sharing INTO Riff is handled by receive_sharing_intent + the custom URL
	  scheme, not by this key. To support the iOS share sheet properly, add a
	  dedicated Share Extension target (separate Info.plist) instead.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Riff needs microphone access to send voice messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Riff needs access to your photo library so you can share photos and videos in posts and chats and set your profile picture.</string>
	<key>NSCameraUsageDescription</key>
	<string>Riff needs camera access so you can take photos and videos to share in posts and chats.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Allow the app to process push notifications (FCM/APNs) in the background -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>riff</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
