# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler: only compile the permissions the app actually uses
    # (microphone, notifications — see `Permission.` call sites in lib/). Every
    # permission left enabled makes Apple's App Store analyzer demand a purpose
    # string for an API the app never calls, causing ITMS-90683 rejections.
    #
    # PERMISSION_CONTACTS was left at 1 after the contacts-sync feature was
    # deleted (commit a776f48), so ContactPermissionStrategy.m kept compiling in
    # its CNContactStore calls and 1.0.14 build 9 was rejected for a missing
    # NSContactsUsageDescription. Nothing in Dart calls Permission.contacts —
    # the fix is to compile it out, not to add a purpose string for data the app
    # doesn't touch.
    #
    # These are appended rather than assigned with `||=`: CocoaPods already
    # populates GCC_PREPROCESSOR_DEFINITIONS on some Pod configurations
    # (POD_CONFIGURATION_DEBUG=1 and friends), and `||=` would silently skip
    # every macro below on those targets.
    permission_macros = [
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_CAMERA=0',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_PHOTOS=0',
        'PERMISSION_LOCATION=0',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
    ]

    target.build_configurations.each do |config|
      existing = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      existing = [existing] if existing.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing + permission_macros
    end
  end
end
