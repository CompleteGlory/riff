default_platform(:android)

platform :android do
  desc "Android Firebase App Distribution"
  lane :firebase_distribution do
    # Run Flutter commands from project root
    Dir.chdir("..") do
      sh "flutter clean"
      # The fallback matters: an unset SPOTIFY_CLIENT_ID used to interpolate to
      # an empty string, producing a build where Connect Spotify silently does
      # nothing (see CLAUDE.md). Public PKCE client id, not a secret.
      spotify_client_id = ENV['SPOTIFY_CLIENT_ID'].to_s.empty? ? '5bf7c19bb7b84c8cb8af0128fa7c59eb' : ENV['SPOTIFY_CLIENT_ID']
      sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons --dart-define=SPOTIFY_CLIENT_ID=#{spotify_client_id}"
    end

    firebase_app_distribution(
      app: "1:369305642937:android:333c95925b65d7ec3d7868",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      testers: "fadyalaa441@gmail.com, fadyalaa2112@gmail.com, zakymagd@gmail.com, magddevf@gmail.com, Danielgeorge369@gmail.com, marten.atef.eng@gmail.com" ,
      upload_timeout: 600,
      release_notes: <<~RELEASE_NOTES
        Version 1.0.20

        Date: 2026-09-04

        Added in this build

        - A camera inside Riff, and it is the picker too. Tap the media
          button when adding to a post or sending a message and the camera
          opens straight away, with your most recent photos already along
          the bottom. Take a new one or tap an old one — no menu first.
        - "All" opens your whole library without leaving the camera. For a
          post you can pick several at once.
        - Recording stops itself at the limit, with a ring that fills as you
          approach it, so a clip too long to send cannot be recorded.
        - Chat can take photos and video at all now. It could only pick
          something you had already saved.

        Fixed in this build

        - Forgot your password now works. The app said a code was on its way
          but no email was ever sent. Codes are emailed for real.
        - "Resend code" resends, instead of taking you back a screen.

        Previously

        - Posting a video works, and a clip too large to upload is refused
          straight away with a reason instead of failing at the end.
        - Videos that would not play on some Android phones now play.
        - Sign in with Apple, and Delete your account in Account settings.

      RELEASE_NOTES
    )
  end
end
