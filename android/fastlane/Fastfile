default_platform(:android)

platform :android do
  desc "Android Firebase App Distribution"
  lane :firebase_distribution do
    # Run Flutter commands from project root
    Dir.chdir("..") do
      sh "flutter clean"
      # The fallback matters: an unset SPOTIFY_CLIENT_ID used to interpolate to
      # an empty string, producing a build where Connect Spotify silently does
      # nothing (see CLAUDE.md). Public PKCE client id, not a secret.
      spotify_client_id = ENV['SPOTIFY_CLIENT_ID'].to_s.empty? ? '5bf7c19bb7b84c8cb8af0128fa7c59eb' : ENV['SPOTIFY_CLIENT_ID']
      sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons --dart-define=SPOTIFY_CLIENT_ID=#{spotify_client_id}"
    end

    firebase_app_distribution(
      app: "1:369305642937:android:333c95925b65d7ec3d7868",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      testers: "fadyalaa441@gmail.com, fadyalaa2112@gmail.com, zakymagd@gmail.com, magddevf@gmail.com, Danielgeorge369@gmail.com, marten.atef.eng@gmail.com" ,
      upload_timeout: 600,
      release_notes: <<~RELEASE_NOTES
        Version 1.0.16

        Date: 2026-09-02

        Added

        - Sign in with Apple. On the login and signup screens, above Continue
          with Google. It shares only your name and email, and you can hide
          your real address behind Apple's private relay if you prefer.
        - Delete your account, from Account settings. The screen lists exactly
          what goes — your profile, posts, reels, comments, likes, messages,
          followers and uploaded media — and asks for your password (or your
          username, if you signed up with Google or Apple) before anything
          happens. Deletion is immediate and permanent.

        Fixed

        - Connect Spotify actually connects. It did nothing at all in 1.0.14:
          no error, no spinner, nothing. If it does fail now, the app tells you
          why instead of quietly returning to the Connect button.
        - Your now-playing track stays visible to other people. It used to
          disappear from everyone else's view an hour after you connected and
          never came back until you reconnected by hand.
        - Sign-in problems now say what went wrong. "Google sign-in was
          cancelled or failed" was shown whether you tapped Cancel, the network
          died, or the app was misconfigured — so there was never anything
          useful to report. Cancelling is now silent, and a real failure shows
          the actual reason.
        - Signing in with Apple no longer fails on a new account. The server
          rejected first-time Apple sign-ins outright; people who had signed in
          before were unaffected, which is why it took a while to spot.
        - Wrong-password messages when deleting an account. A mistyped password
          reported a general server error instead of saying the password was
          wrong.

        Security

        - Sign-in tokens from Google are checked against this app's own
          credentials again. The check had been switched off, which meant a
          Google token issued to an unrelated app would have been accepted.

      RELEASE_NOTES
    )
  end
end
