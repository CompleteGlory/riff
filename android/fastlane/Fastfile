default_platform(:android)

platform :android do
  desc "Android Firebase App Distribution"
  lane :firebase_distribution do
    # Run Flutter commands from project root
    Dir.chdir("..") do
      sh "flutter clean"
      sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons --dart-define=SPOTIFY_CLIENT_ID=#{ENV['SPOTIFY_CLIENT_ID']}"
    end

    firebase_app_distribution(
      app: "1:369305642937:android:333c95925b65d7ec3d7868",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      testers: "fadyalaa441@gmail.com, fadyalaa2112@gmail.com, zakymagd@gmail.com, magddevf@gmail.com, Danielgeorge369@gmail.com, marten.atef.eng@gmail.com" ,
      upload_timeout: 600,
      release_notes: <<~RELEASE_NOTES
        Version 1.0.14

        Date: 2026-08-3

        Added

        - React to a message. Long-press any message — yours or theirs — and
          pick an emoji. Tap the same one again to take it back. Whoever sent
          the message gets a notification, the same as for a new message.
        - Reply to a message. Swipe it sideways, or long-press and choose
          Reply. The reply shows what it is answering, and tapping that quote
          jumps back to the original.
        - Edit a message you have sent. Long-press one of your own messages and
          choose Edit. Edited messages are marked as edited, so nobody is left
          wondering whether they misread it.
        - Pause a voice note while recording it and carry on where you left
          off. It stays one message instead of several.

        Fixed

        - Voice notes no longer play over each other. Starting one stops
          whichever was already playing, and coming back to a note resumes it
          rather than starting it again from the beginning. Leaving a chat
          stops playback instead of letting it follow you.
        - Deleting a message now updates Chats straight away. The conversation
          moves to its proper place in the list and the preview underneath it
          changes to whatever the newest message is now, instead of still
          showing the message you deleted until the next refresh.
        - Random sign-outs. Writing a comment — or anything else that sent
          several requests at once — could quietly end your session, leaving
          every screen failing until you signed in again.
        - "Mark all as read" no longer silently does nothing. It used to stop
          working once you had opened and left the notifications screen, and it
          now tells you if it fails instead of looking like it worked.
        - Opening the app from a message notification: you can reply straight
          away. Before this you had to close and reopen the app first.
        - Notification taps in general: reliable when the app was fully closed,
          no longer land on a blank screen when you are signed out (you get
          taken there after signing in), no longer open the same screen twice,
          and no longer do nothing at all on a flagged-comment notice.
        - Times were showing three hours early throughout the app — message
          timestamps, last seen, and the "x hours ago" labels.
        - The same person could appear twice in Chats: one conversation with
          your messages and an empty one next to it. New ones can't be created,
          and duplicates already on your account are cleaned up.

        Changed

        - Signup no longer asks for a phone number, and contacts sync has been
          removed.

      RELEASE_NOTES
    )
  end
end
