default_platform(:android)

platform :android do
  desc "Android Firebase App Distribution"
  lane :firebase_distribution do
    # Run Flutter commands from project root
    Dir.chdir("..") do
      sh "flutter clean"
      # The fallback matters: an unset SPOTIFY_CLIENT_ID used to interpolate to
      # an empty string, producing a build where Connect Spotify silently does
      # nothing (see CLAUDE.md). Public PKCE client id, not a secret.
      spotify_client_id = ENV['SPOTIFY_CLIENT_ID'].to_s.empty? ? '5bf7c19bb7b84c8cb8af0128fa7c59eb' : ENV['SPOTIFY_CLIENT_ID']
      sh "flutter build apk --release --flavor production --target lib/main_production.dart --no-tree-shake-icons --dart-define=SPOTIFY_CLIENT_ID=#{spotify_client_id}"
    end

    firebase_app_distribution(
      app: "1:369305642937:android:333c95925b65d7ec3d7868",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-production-release.apk",
      testers: "fadyalaa441@gmail.com, fadyalaa2112@gmail.com, zakymagd@gmail.com, magddevf@gmail.com, Danielgeorge369@gmail.com, marten.atef.eng@gmail.com" ,
      upload_timeout: 600,
      release_notes: <<~RELEASE_NOTES
        Version 1.0.18

        Date: 2026-09-04

        Fixed in this build

        - Posting a video works. A clip would upload all the way to 100% and
          then fail with no explanation. Two things were wrong: the app gave
          up waiting after 30 seconds while the server was still storing the
          video, and a phone records far more data per minute than that had
          any chance of finishing. Videos are now capped at one minute and
          the app waits properly.
        - Videos that would not play on some Android phones now play. Clips
          recorded in HEVC crashed the player on certain devices. Everything
          is now delivered in a format every phone can decode, including
          videos posted before this build.

        Changed in this build

        - Photos, videos and voice notes are compressed before they are
          stored. Nothing looks different: photos keep their detail, and
          voice notes are recorded in the quality speech actually needs
          rather than four times that. This is what keeps the app inside its
          media budget as more people join.
        - Deleting something now deletes its files too. A removed post,
          photo, message or conversation used to leave its media behind
          forever. Media shared in more than one place is kept until the last
          copy is gone.

        Previously

        - Sign in with Apple, on the login and signup screens.
        - Delete your account, from Account settings.
        - Continue with Google works on every distributed build, including
          installs from Google Play.
        - Connect Spotify actually connects, and your now-playing track stays
          visible to other people.
        - Automatic crash reporting.

      RELEASE_NOTES
    )
  end
end
